          <button
            onClick={() => {
              toggleShowNewSticky(true);
              stickyOperations.create();
            }}
            className="flex gap-1 text-13 font-medium text-accent-primary my-auto"
            disabled={creatingSticky}
          >
            <Plus className="size-4 my-auto" />
            <span>{t("stickies.add")}</span>
