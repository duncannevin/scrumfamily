import * as React from "react";

import type { ISvgIcons } from "./type";

interface IIconWrapper extends ISvgIcons {
  children: React.ReactNode;
  clipPathId?: string;
  viewBox?: string;
}

export function IconWrapper({
  width = "16",
  height = "16",
  className = "text-current",
  children,
  clipPathId,
  viewBox = "0 0 16 16",
  ...rest
}: IIconWrapper) {
