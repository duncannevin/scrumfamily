                  <Button variant="error-fill" size="lg" tabIndex={1} onClick={handleDeletion} loading={isRemoving}>
                    {currentUser?.id === userDetails.id
                      ? isRemoving
                        ? t("leaving")
                        : t("leave")
                      : isRemoving
                        ? t("removing")
                        : t("remove")}
                  </Button>
                </div>
              </Dialog.Panel>
            </Transition.Child>
          </div>
        </div>
      </Dialog>
    </Transition.Root>
  );
});
