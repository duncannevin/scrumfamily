<file path="packages/types/src/rich-filters/operator-configs/extended.ts">
import type { TFilterValue } from "../expression";

// ----------------------------- EXACT Operator -----------------------------
export type TExtendedExactOperatorConfigs<_V extends TFilterValue> = never;

// ----------------------------- IN Operator -----------------------------
