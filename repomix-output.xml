  });

  it("should preserve comments in function body", async () => {
    const result = await applyTransform(
      transformer,
      `
      export const PreloadResources = () => (
        // usePreloadResources();
        null
      );
      `,
      { parser: "tsx" }
    );

    expect(result).toMatchInlineSnapshot(`
      "export function PreloadResources() {
